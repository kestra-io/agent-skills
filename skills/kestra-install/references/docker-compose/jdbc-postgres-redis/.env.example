# Copy to .env and supply values; Compose rejects empty required values.
# Keep .env private and out of version control.
KESTRA_PORT=8080
KESTRA_URL=http://localhost:8080
KESTRA_USERNAME=
KESTRA_PASSWORD=
KESTRA_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Authenticate to this private registry; verify the licensed version tag.
KESTRA_IMAGE=registry.kestra.io/docker/kestra-ee:v2.0.5
KESTRA_LICENSE_ID=
KESTRA_LICENSE_FINGERPRINT=
# For multiline license keys, use a single-quoted multiline .env value.
KESTRA_LICENSE_KEY=
